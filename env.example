# Copy to `.env.local` and fill values. Never commit real secrets.

# Site URL (sitemap, OAuth redirects, Open Graph)
NEXT_PUBLIC_SITE_URL=https://unibookclub.com

# Supabase (also used in next.config for images.remotePatterns)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (used for auth email redirect in registration)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Allowed university email domains for SELLER verification only (comma-separated)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=asu.edu.jo

# Bootstrap admin emails (see admin panel before DB role is set)
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAILS=mshaeili0111@gmail.com

# Cloudflare Turnstile (register, login, forgot-password, contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
